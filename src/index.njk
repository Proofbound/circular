---
layout: base.njk
permalink: "index.html"
---
{# The front page shows only the current number (site.currentIssue).
   Earlier numbers are reachable from "Previous Numbers" below and
   from back-issues.html. #}
{% set current = collections.articles | selectattr("data.issue", "equalto", site.currentIssue) %}
{% set analysis = current | selectattr("data.section", "equalto", "Analysis") %}
{% set lightReading = current | selectattr("data.section", "equalto", "Light Reading") %}
{% set featured = current | selectattr("data.featured", "equalto", true) | first %}
{% if not featured %}
  {% set featured = current | selectattr("data.order", "equalto", 1) | first %}
{% endif %}
{% set sidebarCount = (analysis | length) + (lightReading | length) - (1 if featured else 0) %}
{% set backIssues = [] %}
{% for iss in issues %}{% if iss.id != site.currentIssue %}{% set backIssues = (backIssues.push(iss), backIssues) %}{% endif %}{% endfor %}

<main>
  <div class="container">
    <div class="front-page">

      <!-- Cover story -->
      <article class="cover-story" aria-label="Cover story">
        <div class="cover-story__kicker">
          <span>{{ featured.data.section }}</span>
          {% if featured.data.subsection %}<span class="sep">·</span><span>{{ featured.data.subsection }}</span>{% endif %}
        </div>

        <h2 class="cover-story__title">
          <a href="articles/{{ featured.fileSlug }}.html">{{ featured.data.title }}</a>
        </h2>

        {% if featured.data.dek %}
        <p class="cover-story__dek">{{ featured.data.dek | safe }}</p>
        {% endif %}

        <p class="cover-story__byline">By {{ featured.data.author }}</p>

        {% if featured.data.leadImage %}
        <figure class="cover-story__figure">
          <img src="articles/{{ featured.data.leadImage.src }}" alt="{{ featured.data.leadImage.alt }}">
          {% if featured.data.leadImage.caption %}<figcaption>{{ featured.data.leadImage.caption | safe }}</figcaption>{% endif %}
        </figure>
        {% endif %}

        <div class="cover-story__body">
          {{ featured.templateContent | firstParagraphs(2) | safe }}
        </div>

        <a class="cover-story__readmore" href="articles/{{ featured.fileSlug }}.html">Continue reading →</a>
      </article>

      <!-- "In This Number" sidebar -->
      {% if sidebarCount > 0 %}
      <aside class="in-this-number" aria-label="In this number">
        <div class="in-this-number__heading">In This Number</div>

        {% if analysis | length %}
        <div class="in-this-number__section">Analysis</div>
        <ul class="in-this-number__list">
          {% for article in analysis %}
            {% if not article.data.featured %}
            <li class="in-this-number__item">
              <span class="in-this-number__author">{{ article.data.author }}</span>
              <a class="in-this-number__title" href="articles/{{ article.fileSlug }}.html">{{ article.data.title }}</a>
              {% if article.data.dek %}
              <span class="in-this-number__dek">{{ article.data.dek | safe }}</span>
              {% endif %}
            </li>
            {% endif %}
          {% endfor %}
        </ul>
        {% endif %}

        {% if lightReading | length %}
        <div class="in-this-number__section">Light Reading</div>
        <ul class="in-this-number__list">
          {% for article in lightReading %}
            {% if not article.data.featured %}
            <li class="in-this-number__item">
              <span class="in-this-number__author">{{ article.data.author }}</span>
              <a class="in-this-number__title" href="articles/{{ article.fileSlug }}.html">{{ article.data.title }}</a>
              {% if article.data.dek %}
              <span class="in-this-number__dek">{{ article.data.dek | safe }}</span>
              {% endif %}
            </li>
            {% endif %}
          {% endfor %}
        </ul>
        {% endif %}
      </aside>
      {% endif %}

    </div>

    <section class="previous-numbers" aria-label="Previous numbers">
      <div class="previous-numbers__heading">Previous Numbers</div>
      {% if backIssues | length %}
      <ul class="previous-numbers__list">
        {% for iss in backIssues | reverse %}
        <li><a href="back-issues.html#{{ iss.id }}">Vol. {{ iss.volume }}, No. {{ iss.number }} &middot; {{ iss.season }}</a></li>
        {% endfor %}
      </ul>
      <p><a href="back-issues.html">Browse all back numbers &rarr;</a></p>
      {% else %}
      <p>This is the inaugural number. Future issues will be listed here.</p>
      {% endif %}
    </section>
  </div>
</main>
